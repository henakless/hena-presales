{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hena-solutions-engineering",
  "account_id": "55f54a0ac034d525ea3049d918fa93de",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "routes": [
    {
      "pattern": "henakless.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra"
  },
  "ratelimits": [
    {
      "name": "BRIEFING_RATE_LIMITER",
      "namespace_id": "714216308",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "observability": {
    "enabled": true
  }
}
