{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hena-solutions-engineering",
  "account_id": "55f54a0ac034d525ea3049d918fa93de",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "routes": [
    {
      "pattern": "henakless.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spanish-buddy",
      "database_id": "d7cb72bd-ee16-40c2-aec4-0b25aa4194cd",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "BRIEFING_RATE_LIMITER",
      "namespace_id": "714216308",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "EVALUATION_RATE_LIMITER",
      "namespace_id": "714216309",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "observability": {
    "enabled": true
  }
}
